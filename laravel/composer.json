{
  "name": "localzet/laravel-personal-analytics",
  "description": "Laravel 13 PostgreSQL-first integration for Localzet Personal Analytics",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://localzet.com",
      "role": "Creator and maintainer"
    }
  ],
  "homepage": "https://github.com/localzet/standalone-analytics",
  "support": {
    "issues": "https://github.com/localzet/standalone-analytics/issues",
    "source": "https://github.com/localzet/standalone-analytics"
  },
  "require": {
    "php": "^8.3",
    "illuminate/bus": "^13.0",
    "illuminate/cache": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/filesystem": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Localzet\\LaravelAnalytics\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Localzet\\LaravelAnalytics\\AnalyticsServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
