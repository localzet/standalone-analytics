{
  "name": "localzet/personal-analytics",
  "description": "Framework-agnostic single-project web analytics collector and reporting library",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://zorin.space",
      "role": "Creator and maintainer"
    }
  ],
  "homepage": "https://github.com/localzet/standalone-analytics",
  "support": {
    "issues": "https://github.com/localzet/standalone-analytics/issues",
    "source": "https://github.com/localzet/standalone-analytics"
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "autoload": {
    "psr-4": {
      "Localzet\\PersonalAnalytics\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Localzet\\PersonalAnalytics\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
